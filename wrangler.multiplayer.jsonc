{
  // ============================================================================
  //  极光记账 · 多人注册版 部署配置
  // ----------------------------------------------------------------------------
  //  这是【多人注册版】的配置，入口是 Multiplayer.js，特点是：
  //    · 支持多人注册，各自独立账本
  //    · 用「安全问题」找回密码（不需要 Turnstile）
  //    · 没有 Turnstile 人机验证，也没有应用内「系统设置」页
  //
  //  怎么选版本、怎么部署，见 README 的「选择部署版本」一节。
  //
  //  KV / R2 依然是「自动创建 + 自动绑定」：只写 binding，不写 id / bucket_name。
  //  name 与个人版不同，所以两套资源互相隔离，不会串数据。
  // ============================================================================

  "$schema": "node_modules/wrangler/config-schema.json",

  // 多人版使用独立的 Worker 名称：
  // 自动创建出来的 KV / R2 会以这个名字为前缀，和个人版完全隔离
  "name": "aurora-accounting-multi",

  "main": "Multiplayer.js",

  "compatibility_date": "2026-09-01",

  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  // KV：账号、会话、登录/找回密码限流计数
  // 不写 "id" → 部署时自动创建 + 自动绑定
  "kv_namespaces": [
    {
      "binding": "ACCOUNTING_KV"
    }
  ],

  // R2：账单 JSON
  // 不写 "bucket_name" → 部署时自动创建 + 自动绑定
  "r2_buckets": [
    {
      "binding": "ACCOUNTING_BUCKET"
    }
  ]

  // 本版本不需要任何环境变量。
}
